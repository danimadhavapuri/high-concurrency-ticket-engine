generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  first_name    String
  last_name     String
  email         String   @unique
  phone_no      String
  password_hash String

  tickets       Ticket[]
}

model Film {
  id               Int        @id @default(autoincrement())
  title            String
  genre            String
  duration         Int
  poster_image_url String?

  showtimes        Showtime[]
}

model Showtime {
  id           Int      @id @default(autoincrement())
  start_time   DateTime
  ticket_price Float

  film_id      Int
  film         Film     @relation(fields: [film_id], references: [id], onDelete: Cascade)

  tickets      Ticket[]
}

model Seat {
  id      Int      @id @default(autoincrement())
  seat_no String   @unique

  tickets Ticket[]
}

model Ticket {
  id          Int      @id @default(autoincrement())
  created_at  DateTime @default(now())

  user_id     Int
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  showtime_id Int
  showtime    Showtime @relation(fields: [showtime_id], references: [id], onDelete: Cascade)

  seat_id     Int
  seat        Seat     @relation(fields: [seat_id], references: [id], onDelete: Cascade)

  @@unique([showtime_id, seat_id]) // Database-level constraint preventing double-booking
}